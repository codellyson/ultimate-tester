{
  "name": "ultimate-tester",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "bin": {
    "ultimate-tester": "bin/ultimate-tester.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "UT_HOME=$PWD nuxt dev --port 4601",
    "build": "nuxt build",
    "serve": "node bin/ultimate-tester.js serve",
    "test": "node --test test/*.test.js",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
