{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultimate Tester",
  "version": "0.2.0",
  "identifier": "com.kreativekorna.ultimate-tester",
  "build": {
    "frontendDist": "loading",
    "beforeBuildCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)\" && sh desktop/stage-engine.sh'"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ultimate Tester",
        "url": "index.html",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        },
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "engine/": "engine/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/codellyson/ultimate-tester/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwMEJFQkIzQzRBQUY0RTYKUldUbTlLckVzK3NMTUdWeTVEdGNzL0hYcy90eWFGOXRqSzZnTGpCMzBCVTFmbjF2RTREVU83MTgK"
    }
  }
}
