{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the engine page may do in the main and Settings windows: folder picker, notifications, Dock badge, Reveal in Finder, and window basics.",
  "windows": [
    "main",
    "settings"
  ],
  "remote": {
    "urls": [
      "http://localhost:4600/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-set-badge-label",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-theme",
    "allow-open-settings",
    "allow-set-menu-state",
    "allow-engine-status",
    "allow-set-draft",
    "dialog:allow-open",
    "dialog:allow-ask",
    "notification:default",
    "opener:allow-reveal-item-in-dir"
  ]
}
